# ==========================================================================
# projectome-atlas — example environment configuration
# --------------------------------------------------------------------------
# Copy this file to .env.<mode> (e.g. .env.development_mouse, .env.staging_macaque)
# and fill in YOUR OWN server URLs before running `npm run dev` / `npm run build`.
#
# Supported modes (set via --mode / VUE_APP_TARGET / VUE_APP_SUB_SPECIES):
#   - development_mouse   (mouse)
#   - beta_mouse          (mouse)
#   - production_mouse    (mouse)
#   - staging_mouse       (mouse)   <- used by `npm run build`
#   - staging_macaque     (macaque, code name "monkey")
#   - production_macaque  (macaque, code name "monkey")
#
# NOTE: VUE_APP_TARGET must be "mouse" or "monkey" (macaque). "fish" is NOT
#       part of this open-source release.
# ==========================================================================

# --- API / data server (replace with your own deployment) ---
VUE_APP_SRV = https://your-server.example.com/srv/
VUE_APP_USER_API = https://your-server.example.com/srv/api/v1
VUE_APP_AI_API = https://your-server.example.com/ai/

# --- Public site / help / tools links (optional, safe to leave blank) ---
VUE_APP_WWW_HOST = https://your-server.example.com
VUE_APP_USER_URL = https://your-server.example.com
VUE_APP_DIGITAL_HOST = https://your-server.example.com
VUE_APP_TOOLS_URL = https://your-server.example.com/tools

# --- Optional external links. Leave blank to disable — the open-source build links to
#     NO internal host by default. ---
# Help / docs page:
VUE_APP_HELP_URL =
# Contact page:
VUE_APP_CONTACT_URL =
# Data portal base (used to build dataset detail links):
VUE_APP_DATACENTER_URL =
# Static asset CDN base (tutorial videos, etc.):
VUE_APP_ASSETS_URL =
# Matomo analytics base. UNSET = no tracking at all (recommended for public forks):
VUE_APP_ANALYTICS_URL =

# --- Target species: "mouse" or "monkey" (macaque). Leave SUB_SPECIES empty
#     for plain mouse / macaque base builds. ---
VUE_APP_TARGET = mouse
VUE_APP_SUB_SPECIES =

# --- neuroviz 3D viewer client ---
VUE_APP_NEUROVIZ = https://static.digital-brain.cn/neuroviz-client
VUE_APP_NEUROVIZ_SRV = wss://mouse.digital-brain.cn/projectome/2/srv
VUE_APP_NEUROVIZ_USE_THREE = true

# --- Reference template (mouse example shown; adjust per species) ---
VUE_APP_REFERENCE_TEMPLATE_HEADER = "api/v1/public/nrrd/info/mouse/hipp/average_template_10.nrrd"
VUE_APP_REFERENCE_TEMPLATE_DATA = "api/v1/public/nrrd/data/mouse/hipp/average_template_10.nrrd"
VUE_APP_REFERENCE_ANNOTATION_HEADER = "api/v1/public/nrrd/info/mouse/hipp/annotation_10.nrrd"
VUE_APP_REFERENCE_ANNOTATION_DATA = "api/v1/public/nrrd/data/mouse/hipp/annotation_10.nrrd"

# --- Misc ---
VUE_APP_PUBLIC_PATH = /
VUE_APP_MODE = production
VUE_APP_META_TITLE = 'Projectome Atlas'
VUE_APP_FAVICON = ''
