# ============================================================
# AI Atlas Backend - Environment Variable Template
# Usage: cp .env.example .env, then fill in your own values
# Note: .env contains sensitive information and is ignored by .gitignore; do not commit it to the repository.
# ============================================================

# ---------- Database (MySQL) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atlas_dev
# Please use a strong password; do not use the weak example password
DB_PASSWORD=change_me_strong_password