# ==== Model serving platform ====
# All three models below are served through the same OpenAI-compatible endpoint.
LLM_MODEL=mistral-small
EMBEDDING_MODEL=your-embedding-model
FUNCTION_CALLING_MODEL=xlam-8b-finetuned

BASE_URL=https://your-openai-compatible-endpoint/v1/
EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1/
API_KEY=your-api-key

# If your endpoint uses a self-signed TLS certificate, set this to true to skip
# certificate verification. Set to false once a trusted cert / CA bundle is in place.
DISABLE_SSL_VERIFY=false

# ==== Langfuse (optional, disabled by default) ====
# LANGFUSE_HOST=http://your-langfuse-host:3000
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
