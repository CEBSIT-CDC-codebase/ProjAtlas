# Copy to .env and fill in. `.env` is gitignored; never commit real keys.
#
#   cp .env.example .env
#
# Loaded by ChatSession.__init__ from this directory (not the working directory),
# so `python -m atlas_assistant.assistant` works from the parent dir too.

# ==== Models ====
# Served through an OpenAI-compatible API. All three names must exist on the endpoint.

# Use whatever name your endpoint serves each model under; the values below are the
# upstream model identifiers used in the paper.

# Generation model for RAG answers, textual summarization and general conversation.
LLM_MODEL=mistralai/Mistral-Small-3.1-24B-Instruct-2503

# Embedding model, used by HippoRAG when building and querying the two indices.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# Fine-tuned function-calling model for the neuron selection and brain
# visualization agents. Deploy separately (e.g. vLLM).
# Weights: ../function-calling/README.md#fine-tuned-model-weights
FUNCTION_CALLING_MODEL=zhang-manyi/ProjAtlas-xLAM2-8B-FunctionCalling-lora

# ==== Endpoint ====
# BASE_URL serves LLM_MODEL and FUNCTION_CALLING_MODEL. Include the trailing /v1/.
BASE_URL=https://your-openai-compatible-endpoint/v1/

# Endpoint serving EMBEDDING_MODEL. Optional: defaults to BASE_URL when unset.
# Set it only if embeddings live behind a different host.
EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1/

# Used for both endpoints, and exported as OPENAI_API_KEY for HippoRAG's
# internal clients. Use a placeholder (e.g. "EMPTY") for endpoints without auth.
API_KEY=your-api-key

# ==== TLS ====
# Set to true only for an endpoint with a self-signed certificate: it disables
# verification process-wide by patching httpx defaults, because HippoRAG builds
# its own clients internally. Keep false wherever a trusted CA bundle is available.
DISABLE_SSL_VERIFY=false
